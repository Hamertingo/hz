{
  // Biome, **lint only**, and the comments are why this file is `.jsonc`.
  //
  // No formatter: every file here is shaped by hand in the style DESIGN.md and
  // CLAUDE.md argue for (aligned object fields, one dense comment where it earns
  // its place), and a formatter's first run would rewrite all of them — a diff
  // nobody can review, in exchange for nothing the eye can see.
  //
  // And not `recommended`: that preset is a style opinion this codebase has
  // already answered its own way, and turning it on reports 163 findings nobody
  // is going to work through — which is the same as having no linter at all. What
  // is on is the set that catches a *mistake* rather than a fashion.
  "$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
  "files": {
    "includes": ["src/**/*.ts", "src/**/*.tsx", "vite.config.ts"]
  },
  // No `vcs` block on purpose. With `useIgnoreFile` set, biome shells out to
  // git, and this checkout carries several thousand untracked files under
  // `apps/agent` — the check itself takes ~100ms and the git walk around it took
  // **70 seconds**. `files.includes` above is the whole scope, so there is
  // nothing left for an ignore file to do.
  "formatter": {
    "enabled": false
  },
  "assist": {
    "enabled": false
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": false,
      "correctness": {
        "recommended": true,
        "noUnusedVariables": "error",
        "noUnusedImports": "error",
        "noUnusedFunctionParameters": "error",
        "useHookAtTopLevel": "error",
        // **Off, and this is the one that costs something.** I would keep it on
        // in most codebases; here it reports 68 sites, every one of them an
        // effect that is *meant* to mount once — a Tauri listener, a window
        // subscription, a `[]`-deps registration whose whole point is that a
        // captured copy would be the state the app launched with. The reason is
        // written at each of those sites, and a rule that is wrong 68 times is
        // noise that hides the 69th.
        "useExhaustiveDependencies": "off"
      },
      "suspicious": {
        "recommended": true,
        "noDoubleEquals": "error",
        "noAssignInExpressions": "error",
        "noFallthroughSwitchClause": "error",
        "noImplicitAnyLet": "error",
        "noSelfCompare": "error",
        "noShadowRestrictedNames": "error",
        "noConsole": "off",
        "noExplicitAny": "off",
        // A transcript row keyed by its position is stable by construction here,
        // and the alternatives are worse.
        "noArrayIndexKey": "off"
      },
      "complexity": {
        "recommended": false,
        "noUselessConstructor": "error",
        "noUselessRename": "error",
        "noUselessSwitchCase": "error",
        "noUselessTypeConstraint": "error",
        "useOptionalChain": "error",
        "noBannedTypes": "off",
        "noExcessiveCognitiveComplexity": "off"
      },
      "style": {
        "recommended": false,
        "useConst": "error",
        "useImportType": "error",
        "noNonNullAssertion": "off",
        "useTemplate": "off"
      },
      // A desktop app whose DOM is not a document: no screen reader opens the
      // tool-group list, and the `role`/`title` a rule wants added to an SVG
      // glyph is ceremony around an icon the reader is looking at.
      "a11y": {
        "recommended": false
      }
    }
  },
  "overrides": [
    {
      // Generated by ts-rs during `cargo test`, never edited by hand.
      "includes": ["src/types/events.ts"],
      "linter": { "enabled": false }
    },
    {
      // Demo pages mount real components with faked inputs and are deleted once
      // they have answered their question. Not shipped code, so a rule aimed at
      // shipped code should not shape them.
      "includes": ["src/demo*.tsx"],
      "linter": { "enabled": false }
    }
  ]
}
