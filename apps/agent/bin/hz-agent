#!/bin/sh
# The agent, run from the source tree this repository owns.
#
# hz ships the CLI it runs rather than borrowing one off the reader's PATH, so
# there is nothing to install before the app works. Two ways to run, in order:
#
# 1. **This tree**, once its dependencies exist — `pnpm install` here, with the
#    install-script approval the CLI's own error message spells out, because one
#    of them is a native SQLite binding npm blocks by default. **This is the
#    build the app runs whenever it is present**, because a change made here is
#    a change to the agent and a launcher that preferred the staged copy would
#    quietly discard every one of them.
# 2. **From the tree staged for the bundle**, which `scripts/vendor-agent.sh`
#    builds and which is what a release ships. Reached when this tree has no
#    `node_modules` — the ordinary state on a machine that only wants the app to
#    work, since the agent's dependencies are several hundred packages.
#
# usage: apps/agent/bin/hz-agent acp
set -e
HERE=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
# `resources/agent/bin/hz-agent`, which is where `vendor-agent.sh` stages it and
# where `binpath` looks too — the rename off `mcode` left this naming a directory
# that no longer exists, so the fallback below never ran.
STAGED="$HERE/../desktop/src-tauri/resources/agent/bin/hz-agent"

# **The node that installed this tree, not whichever one is on PATH.** A native
# module is built for a single ABI — `better-sqlite3` is one — and `PATH` under
# a bundled `.app` is launchd's, which finds whatever the machine happens to have
# installed rather than the one that built the module. See `scripts/pin-node.mjs`.
node_bin=""
if [ -r "$HERE/.node-runtime" ]; then
  read -r node_bin < "$HERE/.node-runtime" || true
  [ -x "$node_bin" ] || node_bin=""
fi
[ -n "$node_bin" ] || node_bin=node

# **The compile cache, which pays for itself on the second launch.** Node parses
# the bundle on every boot — 57MB across 98 files — and this is the only lever on
# that cost outside shipping less code: measured, a quarter off `initialize`.
# The directory is stable on purpose; a temp one would cache nothing.
if [ -z "${HZ_COMPILE_CACHE:-}" ]; then
  cache_home="${HZAGENT_DATA_DIR:-${MINIMAX_DATA_DIR:-$HOME/.hz/agent}}"
  [ -w "$(dirname -- "$cache_home")" ] 2>/dev/null && HZ_COMPILE_CACHE="$cache_home/compile-cache"
  export HZ_COMPILE_CACHE
fi

if [ -d "$HERE/node_modules" ] && [ -f "$HERE/dist/cli.js" ]; then
  if [ -f "$HERE/bin/compile-cache.mjs" ]; then
    exec "$node_bin" --import "$HERE/bin/compile-cache.mjs" "$HERE/dist/cli.js" "$@"
  fi
  exec "$node_bin" "$HERE/dist/cli.js" "$@"
fi

if [ -x "$STAGED" ]; then
  exec "$STAGED" "$@"
fi

if [ -f "$HERE/bin/compile-cache.mjs" ]; then
  exec node --import "$HERE/bin/compile-cache.mjs" "$HERE/dist/cli.js" "$@"
fi

exec node "$HERE/dist/cli.js" "$@"
